# Copia este archivo como backend/.env y llena los valores reales.
# NUNCA subas .env al repositorio. Los valores de abajo son ejemplos NO válidos.

APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./turismo_musical.db
FRONTEND_ORIGIN=http://localhost:5173

# Adaptadores: fake = sin red ni claves (útil para desarrollo y pruebas)
EVENTS_PROVIDER=fake            # ticketmaster | fake
RATES_PROVIDER=fake             # exchangerate_api | open_er_api | fake
PAY_PROVIDER=fake               # factus | fake
INVOICE_PROVIDER=fake           # factus | fake

# --- Ticketmaster Discovery API (https://developer.ticketmaster.com) ---
TICKETMASTER_API_KEY=tm-ejemplo-no-valido
# Precio cobrable del catálogo demo (Discovery no vende boletos; su precio es orientativo)
DEMO_TICKET_PRICE_COP=119000

# --- Tasas de cambio ---
# exchangerate_api (colección del equipo): https://v6.exchangerate-api.com/v6/<FX_API_KEY>/latest/COP
FX_API_KEY=fx-key-ejemplo-no-valida
# open_er_api (alternativa sin clave):
RATES_BASE_URL=https://open.er-api.com/v6/latest/COP

# --- Factus Pay (Sandbox) ---
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_QR_EXPIRATION_SECONDS=900
# Token FIJO obtenido con POST /auth. No se renueva solo: un login nuevo revoca el anterior.
FACTUS_PAY_TOKEN=pay-token-ejemplo-no-valido
# Factus Pay agrega ?key=<esta llave> a la URL del webhook registrada en su panel (sin ?key).
FACTUS_PAY_WEBHOOK_KEY=clave-webhook-ejemplo-no-valida
# Solo para scripts/rotate_pay_token.py (rotación manual; /auth revoca el token anterior):
FACTUS_PAY_EMAIL=correo@ejemplo.com
FACTUS_PAY_PASSWORD=contrasena-ejemplo

# --- Factus API v2 (Sandbox) ---
FACTUS_API_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=client-id-ejemplo
FACTUS_CLIENT_SECRET=client-secret-ejemplo
FACTUS_USERNAME=correo@ejemplo.com
FACTUS_PASSWORD=contrasena-ejemplo
# Opcional: si hay un único rango de factura válido (document=21) se elige solo.
# Si hay varios, defínelo explícitamente.
FACTUS_NUMBERING_RANGE_ID=

# --- Facturación (PENDIENTE: validar con el equipo contable) ---
INVOICE_TAX_CODE=01
INVOICE_TAX_RATE=19.00
INVOICE_PAYMENT_METHOD_CODE=47
INVOICE_SEND_EMAIL=false

# Pruebas contra Sandbox real (backend/tests/test_live_factus.py)
RUN_LIVE_TESTS=0
