              "value": "1e3f0c7a-2b5d-4f8e-9b6c-1a2b3c4"
            },
            {
              "key": "Accept",
              "value": "application/json"
            }
          ],
          "body": {
            "type": "json",
            "content": "{   \n    \"email\" : \"micorreo@gmail.com\",\n    \"password\": \"1234567\"\n}"
          },
          "auth": {
            "type": "noauth"
          },
          "$kind": "http-request",
          "settings": {},
          "scripts": [
            {
              "type": "afterResponse",
              "code": "let response = pm.response.json();\npm.environment.set(\"pay_token\", response.token);",
              "language": "text/javascript"
            }
          ]
        }
      ]
    },
